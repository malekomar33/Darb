rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validIds(ids) {
      return ids is list && ids.size() <= 6
        && ids.hasOnly(['dana', 'umm', 'salt', 'azraq', 'rum', 'petra']);
    }
    function validPlan(p) {
      return p == null || (p is map
        && p.keys().hasAll(['days', 'budget', 'ids', 'interests'])
        && p.keys().hasOnly(['days', 'budget', 'ids', 'interests'])
        && p.days in [1, 3, 5]
        && p.budget is number && p.budget >= 30 && p.budget <= 300
        && validIds(p.ids) && p.ids.size() <= p.days
        && p.interests is list && p.interests.size() <= 3
        && p.interests.hasOnly(['adventure', 'history', 'local']));
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['saved', 'visited', 'plan', 'updatedAt'])
        && validIds(request.resource.data.get('saved', []))
        && validIds(request.resource.data.get('visited', []))
        && validPlan(request.resource.data.get('plan', null))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
